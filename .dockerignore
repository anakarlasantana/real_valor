# =============================================================================
# Real Valor — contexto de build da RAIZ
# =============================================================================
# O contexto de build e enviado ao daemon do Docker. Sem este arquivo, os
# ~914MB de backend/node_modules, ~598MB de frontend/node_modules e ~31MB de
# frontend/.next seriam transmitidos a cada `docker build`, tornando o build
# lento e sujeito a falhas por memoria/espaco em disco.
#
# Quem usa ESTE arquivo: o build do backend (`backend/Dockerfile`, que o Compose
# chama com `context: .` — ele leva o backend e o CRM junto, ver o topo daquele
# Dockerfile). O storefront tem contexto proprio (`./frontend`), com o
# `.dockerignore` dele; o antigo `backend/.dockerignore` morreu na R7, quando o
# contexto deixou de ser `./backend`.
# =============================================================================

# Dependencias (reinstaladas dentro da imagem)
**/node_modules
**/.yarn/cache
**/.yarn/install-state.gz
**/.yarn/unplugged

# Artefatos de build (gerados dentro da imagem)
**/.next
**/.medusa
**/dist
**/build
**/.turbo
**/coverage
**/jest-coverage

# Controle de versao e metadados
.git
.gitignore
.gitattributes
.github

# Segredos — NUNCA entram na imagem
**/.env
**/.env.*
**/.env.local
**/.env.*.local

# Documentacao e ferramentas locais
docs
.vscode
.idea
.run

# O storefront nao entra em NENHUMA imagem a partir daqui: o dele compila no
# contexto `./frontend`. Sem esta linha, `COPY backend/ .` continuaria correto mas
# o contexto carregaria o `frontend/src` inteiro em vao.
frontend

# Uploads do painel: nao entram na imagem (o Dockerfile cria a pasta vazia com
# o dono certo e o compose monta o volume `real_valor_uploads` por cima). Sem
# isto, as fotos do ambiente local seriam ASSADAS na imagem.
backend/static
backend/uploads

# Logs e arquivos temporarios
*.log
**/*.pid
.DS_Store
Thumbs.db

# Diretorios temporarios de verificacao local
.buildtest
.yarncheck-tmp
