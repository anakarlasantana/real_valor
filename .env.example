# =============================================================================
# Real Valor — variaveis de ambiente da stack Docker (modelo versionado)
# =============================================================================
# Copie para a raiz do repositorio:  cp .env.example .env
# O Compose le o `.env` automaticamente. NAO faca `source .env` no shell: uma
# variavel exportada e vazia sobrescreve o arquivo (o `make up` avisa).
#
# DUAS REGRAS QUE EXPLICAM O RESTO DO ARQUIVO:
#   1. URL INTERNA   (http://backend:9000)   -> dentro da rede Docker, pelo nome do servico.
#      URL DO BROWSER (http://localhost:9000) -> fora da rede, pela porta publicada.
#   2. NEXT_PUBLIC_* -> INLINADA no build do frontend: mudar exige reconstruir a imagem.
# =============================================================================

# -----------------------------------------------------------------------------
# Banco e cache
# -----------------------------------------------------------------------------
# Senha do usuario `real_valor`. Troque antes de qualquer uso real.
POSTGRES_USER=real_valor
POSTGRES_PASSWORD=real_valor_pass
POSTGRES_DB=real_valor_db

# Porta no host, so' no loopback (psql/DBeaver). Nao e' a porta usada pelo backend.
POSTGRES_PORT=5439

# URL interna (host `postgres`, porta 5432). `?sslmode=disable` e' obrigatorio.
DATABASE_URL=postgres://real_valor:real_valor_pass@postgres:5432/real_valor_db?sslmode=disable

REDIS_URL=redis://redis:6379

# Porta no host, so' no loopback (mesmo criterio do POSTGRES_PORT).
REDIS_PORT=6382

# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=9000

# URL publica que o painel usa para chamar a API. Local: http://localhost:9000.
# O `make tunnel` grava `https://<tunel>/painel-api` e o `tunnel-stop` devolve.
MEDUSA_BACKEND_URL=http://localhost:9000

# Segredos do Medusa — troque antes de qualquer uso real (`openssl rand -hex 32`).
JWT_SECRET=real_valor_jwt_secret_key_medusa_v2_2026
COOKIE_SECRET=real_valor_cookie_secret_key_medusa_v2_2026

# Origens autorizadas. Precisam refletir as portas publicadas: loja 8000, painel 9000.
# O `make tunnel` acrescenta o endereco publico as tres.
STORE_CORS=http://localhost:8000,http://127.0.0.1:8000
ADMIN_CORS=http://localhost:9000,http://127.0.0.1:9000
AUTH_CORS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:9000,http://127.0.0.1:9000

# Caminho do painel. O default ja' vem de `admin.path` em backend/medusa-config.ts.
# NAO use "/app" (quebra o painel em DEV). Em PROD, reconstrua a imagem com o valor.
# MEDUSA_ADMIN_PATH=/painel

# Hosts extras aceitos pelo painel, alem do default `backend` do compose. SEM esquema.
# Sem isto o painel responde 403 "Blocked request" ate' em localhost:8000/painel.
# O `make tunnel` acrescenta o host do tunel; o `tunnel-stop` devolve.
__MEDUSA_ADMIN_ADDITIONAL_ALLOWED_HOSTS=

# Cria o primeiro admin (idempotente). Vazio = nao cria.
# NAO e' a senha do login: depois de o admin existir, use `make admin-password`.
# O `make tunnel` recusa publicar o painel com a senha de exemplo abaixo.
ADMIN_EMAIL=admin@realvalor.com.br
ADMIN_PASSWORD=admin123456

# 1 = roda `medusa db:migrate` no boot. Deixe comentado: DEV=0 e PROD=1 no compose.
# RUN_MIGRATIONS=1

# -----------------------------------------------------------------------------
# Pagamento — Mercado Pago (Checkout Pro)
# -----------------------------------------------------------------------------
# Segredos do backend. NUNCA use o prefixo NEXT_PUBLIC_ (ele publica no browser).
# Painel MP > Sua aplicacao: MP_ACCESS_TOKEN; Webhooks: MP_WEBHOOK_SECRET.
# Sem o token, o backend sobe e o pagamento fica indisponivel (com aviso no log).
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# `teste` ou `producao` (ausente = teste). NAO deduza do prefixo do token:
# `APP_USR-` tambem e' o formato do token de TESTE; so' `TEST-` e' inequivoco.
# O boot avisa quando ambiente declarado e prefixo se contradizem.
MP_AMBIENTE=teste

# Segredo de assinatura do ambiente de TESTE, quando for diferente do acima (opcional).
MP_WEBHOOK_SECRET_TEST=

# Tolerancia (segundos) entre o `ts` do MP e o nosso relogio. Ausente = 1800. `0` desliga.
# MP_WEBHOOK_TOLERANCIA_SEGUNDOS=1800

# HTTPS publica, terminando em /webhooks/mercadopago (sufixo /pix ou /cartao e' aceito).
# Vazia = o pagamento funciona, mas o pedido so' confirma por consulta manual.
# NAO aponte para `/hooks/payment/...` (rota nativa do Medusa, sem assinatura).
MP_NOTIFICATION_URL=

# Retorno da cliente apos o pagamento. Sem `{id}`, volta para o checkout.
MP_BACK_URL=

# -----------------------------------------------------------------------------
# E-mail transacional (Resend) — pedido confirmado, enviado e cancelado
# -----------------------------------------------------------------------------
# As DUAS ou nada: com so' uma, o provider nao sobe e o e-mail fica no log (`local`).
# RESEND_API_KEY -> Resend Dashboard > API Keys (permite so' "Sending access").
# RESEND_FROM    -> remetente com dominio VERIFICADO; use aspas:
#                   "Real Valor <nao-responda@seudominio.com.br>"
# Templates publicados (rascunho e' recusado): pedido-confirmado, pedido-enviado,
# pedido-cancelado. Ver backend/src/modules/notification/README.md.
RESEND_API_KEY=
RESEND_FROM=

# URL PUBLICA da loja (links dentro do e-mail). NAO e' o FRONTEND_URL, que e' interno.
# Vazio = e-mails sem link. Local: http://localhost:8000. Producao: https://realvalor.com.br
STOREFRONT_URL=

# -----------------------------------------------------------------------------
# Frete — SuperFrete (cotacao e etiqueta)
# -----------------------------------------------------------------------------
# SUPERFRETE_TOKEN -> Painel do SuperFrete > Integracoes > Token da API.
# Sem token, a cotacao FALHA (nao ha' preco de mentira) e a etiqueta fica pendente.
SUPERFRETE_TOKEN=

# `sandbox` ou `producao` (ausente = sandbox).
SUPERFRETE_AMBIENTE=sandbox

# Opcional: libera o webhook de rastreio. Sem ele, `/webhooks/superfrete` responde 401.
# `openssl rand -hex 32`.
SUPERFRETE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Tunel (`make tunnel` / `make tunnel-stop`) — docs/real-valor/11-ambiente-local.md §11.6
# -----------------------------------------------------------------------------
# O `make tunnel` reescreve MP_NOTIFICATION_URL, MP_BACK_URL, NEXT_PUBLIC_BASE_URL,
# MEDUSA_BACKEND_URL e o host extra do painel; o `tunnel-stop` devolve tudo.
# Os CORS NAO sao reescritos: ja' incluem localhost e o dominio fixo de TUNNEL_DOMAIN.
#
# Dominio reservado do ngrok. Sem ele, a URL muda a cada subida e o webhook se perde.
TUNNEL_DOMAIN=

# Porta publicada no tunel: a loja (o painel e os webhooks entram por reescrita).
TUNNEL_PORTA=8000

# Pais das URLs publicas geradas (MP_BACK_URL -> /br/pedido/confirmacao).
TUNNEL_PAIS=br

# =============================================================================
# Storefront (Next.js)
# =============================================================================
# NEXT_PUBLIC_* e' INLINADO no build do frontend: mudar exige `make build`.
# Defini-la so' no `environment:` do compose NAO altera o bundle JS.
# -----------------------------------------------------------------------------

# Browser -> backend (porta publicada no host).
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# SSR -> backend, pela rede Docker. Fora do Compose: http://host.docker.internal:9000
# O Compose entrega este valor ao frontend como build-arg `MEDUSA_BACKEND_URL`.
MEDUSA_INTERNAL_BACKEND_URL=http://backend:9000

# Chave publicavel (pk_) da Store API. Obrigatoria: o build aborta se estiver vazia
# e, sem ela, a home responde 500. Banco novo = token aleatorio: o `make seed`
# imprime a chave (ou Admin > Configuracoes > Chaves de API).
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_88a328b6d11c1a17b01d53e0f19398283fb71b450f7eaeb8d7cb8f2e6047dda2

# URL publica da loja. O `make tunnel` reescreve; em PROD, e' inlinada no build.
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Regiao padrao do storefront.
NEXT_PUBLIC_DEFAULT_REGION=br

# Libera `POST /api/revalidate` (ISR). Obrigatoria; gere com `openssl rand -hex 32`.
#   curl -X POST "http://localhost:8000/api/revalidate?tag=products" \
#        -H "x-revalidate-secret: $REVALIDATE_SECRET"
REVALIDATE_SECRET=troque_este_segredo

# Endereco do servico `frontend` DENTRO da rede (backend -> frontend), nao o do navegador.
# Usado para avisar o storefront apos alterar a vitrine. Sem eles, o aviso e' pulado.
FRONTEND_URL=http://frontend:8000

# Segredo da rota INTERNA `GET /internal/orders/by-cart` (storefront -> backend).
# Nao reutilize o REVALIDATE_SECRET. Sem ele, a pagina de confirmacao responde 503.
# `openssl rand -hex 32`.
INTERNAL_API_SECRET=troque_este_segredo

# =============================================================================
# Comandos uteis
# =============================================================================
#   cp .env.example .env              cria o .env
#   openssl rand -hex 32              gera segredo (REVALIDATE_SECRET, INTERNAL_API_SECRET, ...)
#   make admin-password               troca a senha do painel (antes de `make tunnel`)
#   make tunnel / make tunnel-stop    publica / despublica a loja num endereco publico

