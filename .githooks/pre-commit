#!/bin/sh
# =============================================================================
# Hook de commit — a verificacao que nao pode depender de disciplina humana.
# =============================================================================
# O contrato de conteudo tem uma fonte so (`backend/src/modules/content/`),
# mas o storefront e um pacote npm separado e compila um ARTEFATO GERADO
# dela. Editar o backend e esquecer de rodar o gerador passa despercebido ate
# alguem abrir a loja — entao a trava fica aqui.
#
# Ativacao (uma vez por clone):
#     git config core.hooksPath .githooks
#
# Roda em menos de um segundo (Node lendo arquivos, sem a stack de pe) e e o
# mesmo que `make check`. A saida de `--no-verify` e explicita: quem pula, pula
# sabendo.
# =============================================================================
set -e

cd "$(git rev-parse --show-toplevel)"

node scripts/gen-content.mjs --check
node scripts/check-contract-parity.mjs
